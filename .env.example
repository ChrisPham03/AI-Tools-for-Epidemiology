# Copy to .env and fill in. Never commit .env.
AWS_REGION=ca-central-1
# Bedrock model ID from the Bedrock console (model must be enabled for your account/region)
BEDROCK_MODEL_ID=
# Credentials: use an AWS profile, or set keys here
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
